# ─────────────────────────────────────────────────────────────────────────────
# Frontend (.env.local)
# `npx convex dev` writes these for you on first run. In Vercel, set VITE_CONVEX_URL
# to the production deployment's URL.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site
# Sign-in: Clerk dashboard → Configure → API keys. Set it in Vercel too.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...


# ─────────────────────────────────────────────────────────────────────────────
# Convex deployment
# These live on the deployment, not in a file. `npm run setup` (add -- --prod
# for production) generates and sets them. Dev and production each need their own.
# ─────────────────────────────────────────────────────────────────────────────

# Encrypts the keys people save in Connections (32 random bytes, base64). Never change it once set.
ENCRYPTION_KEY=

# Sign-in (Clerk): required for the dashboard. The Frontend API URL from Clerk
# (Configure → API keys); `npm run setup` asks for it.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev


# ─────────────────────────────────────────────────────────────────────────────
# Engine (runner/.env, or the engine machine's environment)
# The engine keeps messages and contacts on its own machine; they never go to Convex.
# Keys set here stay on this machine too. Keys saved in Connections are stored in Convex,
# encrypted, and every engine of the account gets them. See runner/README.md.
# ─────────────────────────────────────────────────────────────────────────────

OPENBOTS_CONVEX_URL=https://your-deployment-name.convex.cloud
# Connections → Add engine (shown once)
OPENBOTS_TOKEN=obr_...
# OPENBOTS_DATA_DIR=/path/to/dir   (default ~/.openbots; back up both files in it)

# Or enter these in the dashboard (Connections); a key entered there wins.
# AI: set the ones you use. The engine lists the models each key can use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# A local model server (Ollama, LM Studio…): nothing leaves your machines
OPENBOTS_LOCAL_URL=http://localhost:11434/v1

# Texting: one or more
# Messages on this Mac (on by default on macOS when nothing else is set up)
OPENBOTS_MAC=
# Where Twilio, Sendblue or BlueBubbles reach this engine's web server (port OPENBOTS_PORT, default 8787)
OPENBOTS_PUBLIC_URL=
# Or get one from Cloudflare's quick tunnel (needs cloudflared; Orgo computers use this)
OPENBOTS_TUNNEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Your own relay
OPENBOTS_INBOUND_SECRET=
OPENBOTS_RELAY_URL=
OPENBOTS_RELAY_SECRET=

# Email handoff alerts too (optional)
RESEND_API_KEY=
RESEND_FROM=

# "true" answers with sample replies when no AI key is set up
OPENBOTS_DEMO=
