# ─────────────────────────────────────────────────────────────────────────────
# Frontend (.env.local)
# `npx convex dev` writes these for you on first run. In Vercel, set VITE_CONVEX_URL
# to the production deployment's URL.
# ─────────────────────────────────────────────────────────────────────────────

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site


# ─────────────────────────────────────────────────────────────────────────────
# Convex deployment
# These live on the deployment, not in a file. Set each one with
#   npx convex env set "NAME=value"
# or in the Convex dashboard. Dev and production each need their own.
# ─────────────────────────────────────────────────────────────────────────────

# Sign-in (Convex Auth): required for the dashboard
# JWT_PRIVATE_KEY and JWKS are a key pair; generate them together (see README → Sign-in).
# Use the NAME=value form, since the key starts with "-----BEGIN" and would be read as a flag otherwise.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
JWKS={"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}
# Where the dashboard is served (dev: http://localhost:5173)
SITE_URL=http://localhost:5173


# ─────────────────────────────────────────────────────────────────────────────
# Agent (runner/.env, or the agent machine's environment)
# The agent keeps messages, contacts, keys and account logins on its own
# machine; none of these ever go to Convex. See runner/README.md.
# ─────────────────────────────────────────────────────────────────────────────

OPENBOTS_CONVEX_URL=https://your-deployment-name.convex.cloud
# Connections → Add agent (shown once)
OPENBOTS_TOKEN=obr_...
# OPENBOTS_DATA_DIR=/path/to/dir   (default ~/.openbots; back up both files in it)

# AI: set the ones you use. The agent lists the models each key can use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# A local model server (Ollama, LM Studio…): nothing leaves your machines
OPENBOTS_LOCAL_URL=http://localhost:11434/v1

# Texting: one or more
# Messages on this Mac (on by default on macOS when nothing else is set up)
OPENBOTS_MAC=
# Where Twilio, Sendblue or BlueBubbles reach this agent's web server (port OPENBOTS_PORT, default 8787)
OPENBOTS_PUBLIC_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
BLUEBUBBLES_URL=
BLUEBUBBLES_PASSWORD=
# Your own relay
OPENBOTS_INBOUND_SECRET=
OPENBOTS_RELAY_URL=
OPENBOTS_RELAY_SECRET=

# Email handoff alerts too (optional)
RESEND_API_KEY=
RESEND_FROM=

# "true" answers with sample replies when no AI key is set up
OPENBOTS_DEMO=
